# Salin ke .env.local lalu isi nilainya. Jangan pernah commit nilai asli.
# DATABASE_URL: koneksi pooled dari Neon (Vercel Marketplace).
DATABASE_URL=
# DATABASE_URL_UNPOOLED: dipakai drizzle-kit untuk migrasi.
DATABASE_URL_UNPOOLED=
# Minimal 32 karakter acak.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Aktifkan hanya untuk demo publik yang memakai akun seed.
DEMO_MODE=false
# Wajib untuk npm run db:seed (minimal 12 karakter). Nilai tidak pernah dicetak.
DEMO_SEED_PASSWORD=
# Opsional: gaya peta MapLibre. Default memakai OpenFreeMap Positron.
NEXT_PUBLIC_MAP_STYLE_URL=
# Opsional: rahasia untuk endpoint drain outbox terjadwal.
CRON_SECRET=
